{
  "name": "boardroom-platform",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "packages/shared",
    "packages/omnimind-api",
    "packages/boardroom-ai",
    "packages/omnimind-mcp"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:eval": "vitest run --dir eval",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "eval:retrieval": "tsx eval/runners/eval-retrieval.ts",
    "eval:retrieval:seed": "tsx eval/retrieval/seed.ts",
    "eval:retrieval:ir": "tsx eval/runners/eval-retrieval-ir.ts",
    "eval:personas": "tsx eval/runners/eval-personas.ts",
    "eval:e2e": "tsx eval/runners/eval-e2e.ts",
    "eval:all": "npm run eval:retrieval && npm run eval:personas && npm run eval:e2e",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "e2e:live": "node tests/e2e/live/journey.mjs",
    "pre-deploy": "bash scripts/pre-deploy-check.sh",
    "go-live:mcp": "bash scripts/mcp-go-live.sh",
    "test:go-live": "bash scripts/tests/mcp-go-live.test.sh && bash scripts/tests/verify-prod.test.sh",
    "verify:prod": "bash scripts/verify-prod.sh",
    "import:vault": "node scripts/vault-import.mjs",
    "test:vault-import": "node --test scripts/tests/vault-import.test.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ],
    "overrides": {
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "hono@<4.12.25": ">=4.12.25",
      "fast-uri@>=3.0.0 <=3.1.3": ">=3.1.4",
      "ip-address@<10.7.4": ">=10.7.4",
      "qs@<6.16.0": ">=6.16.0",
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "@types/node": "^22.0.0",
      "proxy-addr@<2.0.8": ">=2.0.8"
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/client": "^6.3.0",
    "playwright": "1.56.1",
    "tsx": "^4.19.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
